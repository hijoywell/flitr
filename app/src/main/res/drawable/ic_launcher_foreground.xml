<?xml version="1.0" encoding="utf-8"?>
<!--
  蜂鸟前景层 (自适应图标 108dp 画布)。

  安全区约束: 可见区域是以中心为圆心的 66dp 圆, 所有内容控制在 [21,87] 区间内。

  设计要点 (第一版踩过的坑):
  1. 羽毛必须是**独立的开放曲线**, 不能用带白填充的闭合形状压在身体上 ——
     白填充会盖掉身体轮廓, 几个形状挤在一起就糊成一坨, 什么都认不出来。
  2. 形状之间要留出负空间, 48dp 下靠的是"分隔"而不是"细节"。
  3. 身体是一个蛋形, 头部靠喙和眼睛来区分, 不强行画脖子。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 身体 + 头: 蛋形轮廓, 白底黑描边 -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#111111"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M71,38 C69,31 60,28 53,32 C45,37 40,47 39,57 C38,67 44,73 52,73 C60,73 68,67 70,57 C71,50 72,44 71,38 Z" />

    <!-- 上翼三片羽毛: 独立曲线, 从背部向左上掠出, 相互之间留空 -->
    <path
        android:strokeColor="#111111"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M44,39 C36,33 29,28 23,25" />
    <path
        android:strokeColor="#111111"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M45,47 C37,42 30,37 24,34" />
    <path
        android:strokeColor="#111111"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M47,54 C40,50 33,46 27,43" />

    <!-- 尾羽两片: 向左下 -->
    <path
        android:strokeColor="#111111"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M43,66 C36,72 30,77 25,82" />
    <path
        android:strokeColor="#111111"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M49,71 C43,77 37,82 32,86" />

    <!-- 喙: 蜂鸟的标志是细长的喙。描边要细, 否则白底被吃掉只剩一块深色 -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#111111"
        android:strokeWidth="3.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M70,38 L88,43 L69,45 Z" />

    <!-- 眼睛 -->
    <path
        android:fillColor="#111111"
        android:pathData="M61,36 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />

    <!-- 腮红: 紧贴眼睛下方 -->
    <path
        android:fillColor="#111111"
        android:pathData="M55.4,44 a3,2.2 0 1,0 6,0 a3,2.2 0 1,0 -6,0 Z" />

    <!-- 爪 -->
    <path
        android:strokeColor="#111111"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M53,74 C53,77 52,79 51,81 M58,73 C58,76 57,78 56,80" />
</vector>
